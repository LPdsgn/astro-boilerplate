{
	"name": "@lpdsgn/astro-boilerplate",
	"title": "Astro Project Boilerplate",
	"type": "module",
	"version": "1.0.0",
	"engines": {
		"node": ">=22.12.0",
		"pnpm": ">=11"
	},
	"packageManager": "pnpm@11.3.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/lpdsgn/astro-boilerplate.git"
	},
	"author": {
		"name": "Luigi Pedata",
		"email": "luigi@lpdsgn.it",
		"homepage": "https://lpdsgn.it"
	},
	"imports": {
		"#styles": "./src/styles/main.css"
	},
	"scripts": {
		"prepare": "lefthook install",
		"clean": "rm -rf dist .astro .vercel/output",
		"dev": "astro dev --host",
		"dev:stop": "astro dev stop",
		"start": "astro dev --host",
		"check": "astro check",
		"build": "astro check && astro build",
		"build:debug": "astro check && astro build 2>&1 | grep -E \"\\[ERROR\\]|\\[vite\\]|Cannot apply unknown|Could not resolve|Can't resolve|Unable to locate|✓ Completed|Build failed|Build complete|ELIFECYCLE\"",
		"preview": "astro preview",
		"astro": "astro",
		"format": "prettier --write .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"precommit": "pnpm lint:fix && pnpm format"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/mdx": "^8.0.2",
		"@astrojs/vercel": "^11.0.11",
		"@iconify-json/carbon": "^1.2.28",
		"@iconify-json/simple-icons": "^1.2.98",
		"@locomotivemtl/grid-helper": "^1.1.0",
		"@lpdsgn/astro-themes": "^0.2.0",
		"@lpdsgn/gsap-spa-manager": "^1.0.0",
		"@swup/a11y-plugin": "^5.2.1",
		"@swup/body-class-plugin": "^3.3.0",
		"@swup/debug-plugin": "^4.1.0",
		"@swup/head-plugin": "^2.3.1",
		"@swup/preload-plugin": "^3.2.12",
		"@swup/progress-plugin": "^3.2.0",
		"@swup/route-name-plugin": "^4.1.0",
		"@swup/scripts-plugin": "^2.1.0",
		"@tailwindcss/forms": "^0.5.11",
		"astro": "7.3.5",
		"astro-capo": "^0.0.1",
		"astro-embed": "^0.14.0",
		"astro-favicons": "^3.1.8",
		"astro-icon": "^1.2.0",
		"astro-meta-tags": "^0.4.1",
		"astro-seo": "^1.2.0",
		"embla-carousel": "^8.6.0",
		"gsap": "^3.15.0",
		"locomotive-scroll": "^5.0.1",
		"nanostores": "^1.5.4",
		"satori-astro": "^0.4.0",
		"satori-html": "^0.3.2",
		"sharp": "^0.35.5",
		"swup": "^4.10.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"ts-debounce": "^5.0.1",
		"tw-animate-css": "^1.4.0",
		"vanilla-cookieconsent": "^3.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@vercel/config": "^0.9.0",
		"autoprefixer": "^10.6.1",
		"cssnano": "^7.1.9",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^1.7.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"globals": "^17.13.0",
		"lefthook": "^2.1.16",
		"postcss": "^8.5.28",
		"postcss-nested": "^8.0.1",
		"postcss-utopia": "^1.1.0",
		"prettier": "^3.9.9",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-astro-organize-imports": "^0.4.14",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"rollup-plugin-visualizer": "^7.1.1",
		"sonda": "^0.14.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0"
	},
	"browserslist": [
		"defaults",
		"fully supports es6-module",
		"> 0.2%"
	]
}
