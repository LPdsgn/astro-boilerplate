---
import type { HTMLAttributes } from 'astro/types';
import { tv } from 'tailwind-variants';

type Props = HTMLAttributes<'div'>;

export const buttonGroupText = tv({ base: ['c-buttonGroupText'] });

const { class: className, ...rest } = Astro.props;
---

<div class={buttonGroupText({ class: className })} data-slot="button-group-text" {...rest}>
	<slot />
</div>

<style is:global lang="postcss">
	@reference "#styles";
	@layer components {
		/* Same metrics as .c-button.-medium so it lines up inside a ButtonGroup */
		.c-buttonGroupText {
			@apply flex items-center gap-3xs rounded-fluid-xs border bg-muted px-xs whitespace-nowrap;
			@apply text-label font-mono leading-1! font-semibold tracking-tight uppercase;
			@apply [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4;
			height: utopia.clamp(31, 38);
		}
	}
</style>
