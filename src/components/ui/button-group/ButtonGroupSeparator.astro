---
import type { HTMLAttributes } from 'astro/types';
import { tv } from 'tailwind-variants';

import { Separator } from '@/components/ui/separator';

type Props = HTMLAttributes<'div'> & {
	/**
	 * The orientation of the separator.
	 * @default "vertical"
	 */
	orientation?: 'horizontal' | 'vertical';
};

export const buttonGroupSeparator = tv({ base: ['c-buttonGroup_separator'] });

const { class: className, orientation = 'vertical', ...rest } = Astro.props;
---

<Separator
	data-slot="button-group-separator"
	orientation={orientation}
	class={buttonGroupSeparator({ class: className })}
	{...rest}
/>

<style is:global lang="postcss">
	@reference "#styles";
	@layer components {
		.c-buttonGroup_separator {
			@apply relative m-0! self-stretch bg-border data-[orientation=vertical]:h-auto;
		}
	}
</style>
