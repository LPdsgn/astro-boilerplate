---
import type { HTMLAttributes } from 'astro/types';
import { tv, type VariantProps } from 'tailwind-variants';

type Props = HTMLAttributes<'div'> & VariantProps<typeof buttonGroup>;

export const buttonGroup = tv({
	base: ['c-buttonGroup'],
	variants: {
		orientation: {
			horizontal: '-horizontal',
			vertical: '-vertical',
		},
	},
	defaultVariants: { orientation: 'horizontal' },
});

const { class: className, orientation = 'horizontal', ...rest } = Astro.props;
---

<div
	role="group"
	data-slot="button-group"
	data-orientation={orientation}
	class={buttonGroup({ orientation, class: className })}
	{...rest}
>
	<slot />
</div>

<style is:global lang="postcss">
	@reference "#styles";
	@layer components {
		/* Joins Button (.c-button) and ButtonGroupText (.c-buttonGroupText) items: the shared
		   edges lose radius and border. Adjacent-sibling selectors ignore the <script> that
		   Astro renders in place after the last item. */
		.c-buttonGroup {
			@apply flex w-fit items-stretch;

			> * {
				@apply focus-visible:relative focus-visible:z-10;
			}
			/* Nested groups */
			&:has(> .c-buttonGroup) {
				@apply gap-2xs;
			}
		}
		.c-buttonGroup.-horizontal {
			> :is(.c-button, .c-buttonGroupText) + :is(.c-button, .c-buttonGroupText) {
				@apply rounded-l-none border-l-0;
			}
			> :is(.c-button, .c-buttonGroupText):has(+ :is(.c-button, .c-buttonGroupText)) {
				@apply rounded-r-none;
			}
		}
		.c-buttonGroup.-vertical {
			@apply flex-col;

			> :is(.c-button, .c-buttonGroupText) + :is(.c-button, .c-buttonGroupText) {
				@apply rounded-t-none border-t-0;
			}
			> :is(.c-button, .c-buttonGroupText):has(+ :is(.c-button, .c-buttonGroupText)) {
				@apply rounded-b-none;
			}
		}
	}
</style>
