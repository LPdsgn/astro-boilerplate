---
import type { HTMLAttributes } from 'astro/types';
import { tv, type VariantProps } from 'tailwind-variants';

interface Props extends HTMLAttributes<'div'>, VariantProps<typeof containerVariants> {
	as?:
		| 'div'
		| 'header'
		| 'footer'
		| 'section'
		| 'article'
		| 'aside'
		| 'main'
		| 'nav'
		| 'li'
		| 'ul'
		| 'ol';
	theme?: string;
}

export const containerVariants = tv({
	base: 'u-container',
	variants: {
		size: {
			default: '-default',
			narrow: '-narrow',
			wide: '-wide',
		},
		flow: {
			row: 'flex',
			rowWrap: 'flex flex-wrap',
			col: 'flex flex-col',
			grid: 'grid',
		},
		px: {
			true: '-px',
		},
	},
	defaultVariants: {
		size: 'default',
		px: true,
	},
});

const {
	// Defaults
	class: className,
	id,
	size,
	flow,
	px,
	as: HTMLelement = 'div',
	theme,
	...rest
} = Astro.props;
---

<HTMLelement
	id={id}
	class={containerVariants({ size, flow, px, class: className })}
	data-theme={theme}
	{...rest}
>
	<slot />
</HTMLelement>

<style is:global lang="postcss">
	@reference "#styles";

	@layer components {
		.u-container {
			@apply mx-auto gap-fluid-sm py-fluid-md w-full;

			&.-px {
				@apply px-margin;
			}

			/* Same side margin as `.container` and the grid helper (src/lib/app.ts) */
			&.-default.-px {
				@apply px-well;
			}

			&.-narrow {
				@apply max-w-screen-md;
			}

			&.-wide {
				@apply max-w-none;
			}
		}
	}
</style>
