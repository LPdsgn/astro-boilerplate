---
// The theme itself is handled by @lpdsgn/astro-themes (ThemeProvider in Layout.astro):
// this toggle only reads and sets it through the client API.

import { Icon } from 'astro-icon/components';
import { tv, type VariantProps } from 'tailwind-variants';

import { Toggle, ToggleVariants } from '@/components/ui/toggle';

export const themeToggle = tv({
	base: [
		'c-theme-toggle',
		'group hover:border-muted-foreground hover:bg-transparent data-[state=on]:bg-transparent',
	],
});

type Props = VariantProps<typeof ToggleVariants.toggle> & {
	/**
	 * The ARIA label for the toggle
	 */
	ariaLabel?: string;
	/**
	 * Additional classes for the toggle
	 */
	class?: string;
};

const {
	class: className = '',
	variant = 'outline',
	size = 'md',
	ariaLabel = 'Toggle theme',
	...rest
} = Astro.props as Props;
---

<Toggle
	class={themeToggle({ class: className })}
	variant={variant}
	size={size}
	aria-label={ariaLabel}
	data-slot="theme-toggle"
	{...rest}
>
	<slot>
		<span class="size-5" data-theme-icon-wrapper>
			<slot name="light-icon">
				<Icon
					name="carbon:sun"
					class="hidden size-5 group-data-[state=off]:data-ready:block"
					data-theme-icon
				/>
			</slot>
			<slot name="dark-icon">
				<Icon
					name="carbon:moon"
					class="hidden size-5 group-data-[state=on]:data-ready:block"
					data-theme-icon
				/>
			</slot>
		</span>
	</slot>
</Toggle>

<script>
	import type { ToggleChangeEvent } from '@/components/ui/toggle';
	import { init } from '@/lib/classes';
	import { getResolvedTheme, onThemeChange, setTheme } from '@lpdsgn/astro-themes/client';

	class ThemeToggleHandler {
		private toggle: HTMLButtonElement;
		private isInitializing = true;

		constructor(toggle: HTMLButtonElement) {
			this.toggle = toggle;
			this.syncState(getResolvedTheme() === 'dark');
			// Mark icons as ready to show (prevents flash of wrong icon)
			this.toggle.querySelectorAll('[data-theme-icon]').forEach((icon) => {
				icon.setAttribute('data-ready', '');
			});
			this.toggle.addEventListener('c-toggle:change', (event: Event) =>
				this.handleToggleChange(event)
			);
			// Mark initialization complete after a microtask
			queueMicrotask(() => {
				this.isInitializing = false;
			});
		}

		private handleToggleChange(event: Event): void {
			if (this.isInitializing) return;
			const { pressed } = (event as ToggleChangeEvent).detail;
			// astro-themes updates <html>, localStorage and the other tabs, then notifies onThemeChange
			setTheme(pressed ? 'dark' : 'light');
		}

		public syncState(isDark: boolean): void {
			const newState = isDark ? 'on' : 'off';
			// Only update if state actually changed to prevent loops
			if (this.toggle.getAttribute('data-state') !== newState) {
				this.toggle.setAttribute('data-state', newState);
				this.toggle.setAttribute('aria-pressed', String(isDark));
			}
		}
	}

	// One handler per element; the Set makes them iterable for the theme-change sync
	const themeToggleInstances: WeakMap<HTMLElement, ThemeToggleHandler> = new WeakMap();
	const activeToggles: Set<HTMLButtonElement> = new Set();

	const setupThemeToggles = () => {
		activeToggles.clear();
		document.querySelectorAll<HTMLButtonElement>('.c-theme-toggle').forEach((toggle) => {
			if (!themeToggleInstances.has(toggle)) {
				themeToggleInstances.set(toggle, new ThemeToggleHandler(toggle));
			}
			activeToggles.add(toggle);
		});
	};

	// Theme changed from any toggle, tab or system preference: sync every toggle on the page
	onThemeChange(({ resolvedTheme }) => {
		activeToggles.forEach((toggle) => {
			themeToggleInstances.get(toggle)?.syncState(resolvedTheme === 'dark');
		});
	});

	init('ThemeToggles', setupThemeToggles);
</script>
