---
import type { HTMLTag, Polymorphic } from 'astro/types';
import { tv } from 'tailwind-variants';

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	/**
	 * Variant of the item
	 * @default "default"
	 */
	variant?: 'default' | 'outline' | 'muted';
	/**
	 * Size of the item
	 * @default "default"
	 */
	size?: 'default' | 'sm';
};

export const item = tv({
	// group/item: scope for consumers' group-*/item: variants
	base: ['c-item', 'group/item'],
	variants: {
		variant: {
			default: '-default',
			outline: '-outline',
			muted: '-muted',
		},
		size: {
			default: '-medium',
			sm: '-small',
		},
	},
	defaultVariants: {
		variant: 'default',
		size: 'default',
	},
});

const {
	variant = 'default',
	size = 'default',
	class: className,
	as: Tag = 'div',
	...rest
} = Astro.props;
---

<Tag class={item({ variant, size, class: className })} data-slot="item" {...rest}>
	<slot />
</Tag>

<style is:global lang="postcss">
	@reference "#styles";
	@layer components {
		.c-item {
			@apply flex flex-wrap items-center rounded-md border border-transparent text-sm transition-colors;
			@apply outline-none focus-visible:border-outline focus-visible:ring-[3px] focus-visible:ring-outline/50;

			&:is(a) {
				@apply hover:bg-accent/50;
			}
		}
		.c-item.-default {
			@apply bg-transparent;
		}
		.c-item.-outline {
			@apply border-border;
		}
		.c-item.-muted {
			@apply bg-muted/50;
		}
		.c-item.-medium {
			@apply gap-4 p-4;
		}
		.c-item.-small {
			@apply gap-2.5 px-4 py-3;
		}
	}
</style>
