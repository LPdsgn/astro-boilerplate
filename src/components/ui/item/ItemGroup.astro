---
import type { HTMLAttributes } from 'astro/types';
import { tv } from 'tailwind-variants';

type Props = HTMLAttributes<'div'>;

export const itemGroup = tv({
	// group/item-group: scope for consumers' group-*/item-group: variants
	base: ['c-itemGroup', 'group/item-group'],
});

const { class: className, ...rest } = Astro.props;
---

<div role="list" class={itemGroup({ class: className })} data-slot="item-group" {...rest}>
	<slot />
</div>

<style is:global lang="postcss">
	@reference "#styles";
	@layer components {
		.c-itemGroup {
			@apply flex flex-col;
		}
	}
</style>
