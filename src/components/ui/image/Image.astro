---
import type { ComponentProps } from 'astro/types';
import { Image as AstroImage } from 'astro:assets';

type Props = Partial<ComponentProps<typeof AstroImage>> & {
	inferSize?: boolean;
	tag?: 'div' | 'figure';
	caption?: boolean | string;
	pixelated?: boolean;
};

const {
	src = import('@/assets/images/placeholder.jpg'),
	alt = '',
	title = null,
	tag = 'figure',
	width,
	height,
	caption,
	class: propsClass,
	widths = [720, 1440, 1920],
	sizes = '(max-width: 720px) 720px, (max-width: 1440px) 1440px, 1920px',
	loading = 'lazy',
	pixelated = false,
	...rest
} = Astro.props;

// Set the tag based on the prop
const Tag = tag === 'figure' ? 'figure' : 'div';
const CaptionTag = tag === 'figure' ? 'figcaption' : 'div';

// Set the onload event based on the loading prop
const onLoad = `this.closest('.c-image')?.classList?.add('is-loaded');`;

const classes = [
	'c-image',
	width && height && '-cover',
	loading === 'lazy' && '-lazy-load',
	pixelated && '-pixelated',
	propsClass,
];
---

{
	src && (
		<>
			<Tag class:list={classes} style={{ '--width': width, '--height': height }} {...rest}>
				<AstroImage
					class="c-image_img"
					src={src}
					alt={alt}
					inferSize={typeof src === 'string'}
					onload={onLoad}
					data-slot="image"
					{...(rest as any)}
				/>
				{pixelated && <div class="c-image_pixels" />}

				{caption && <CaptionTag class="c-image_caption">{caption}</CaptionTag>}
			</Tag>

			{pixelated && <script src="./image.ts" />}
		</>
	)
}

<style is:global lang="postcss">
	@reference "#styles";

	@layer components {
		.c-image {
			@apply relative overflow-hidden bg-background text-primary;

			&.-pixelated {
				.c-image_img {
					visibility: hidden;
				}

				&.is-active {
					.c-image_img {
						visibility: visible;
					}
				}
			}
		}

		.c-image_img {
			width: 100%;

			.c-image.-cover & {
				object-fit: cover;
				aspect-ratio: var(--width) / var(--height);
			}

			&[loading='lazy'] {
				.c-image.-lazy-load & {
					opacity: 0;
					transform: scale(1.1, 1.1);
					transition:
						transform theme-speed(slow) theme-ease(),
						opacity theme-speed(slow) theme-ease();
				}

				/* Image is loaded */
				.c-image:not([data-scroll]).is-loaded & {
					opacity: 1;
					transform: scale(1, 1);
				}

				/* Image is loaded and respond to locomotive-scroll in-view class */
				.c-image[data-scroll].is-loaded.is-inview & {
					opacity: 1;
					transform: scale(1, 1);
				}
			}
		}

		.c-image_pixels {
			width: 100%;
			height: 100%;
			position: absolute;
			top: 0;
			left: 0;
		}

		.c-image_pixel {
			background-color: currentColor;
			width: 100%;
			height: 100%;
			display: none;
			position: absolute;
			@apply ring-1 ring-[currentColor];
		}

		.c-image_caption {
			@apply text-label font-mono uppercase text-muted-foreground mt-[1em];
		}
	}
</style>
